# GoldRush 2.0 C++ 选手编译
# 用法: make         -> 编译 player.so
#       make clean   -> 清理

CXX      = g++
CXXFLAGS = -std=c++17 -O2 -march=native -fPIC -Wall -I.

SOLUTION = solutions/player.cpp
TARGET   = player.so

all: $(TARGET)

$(TARGET): $(SOLUTION) game_api.h
	$(CXX) $(CXXFLAGS) -shared -o $(TARGET) $(SOLUTION)

clean:
	rm -f $(TARGET)

.PHONY: all clean
